# Configuration GMINI-Web-Proxy (v1.2.0) — copier vers .env (droits 0600) et adapter.
# Les variables d'environnement du processus sont toujours prioritaires sur ce fichier.
# Ne jamais partager ni commiter .env ou cookie.txt.

# --- Réseau & Sécurité ---
# Adresse d'écoute (boucle locale par défaut ; un port nu ou :8081 reste sur 127.0.0.1).
GEMINI_LISTEN=127.0.0.1:8081
# Clé(s) API locale(s) séparées par des virgules (OBLIGATOIRE au démarrage sauf GEMINI_ALLOW_NO_AUTH=1).
GEMINI_API_KEYS=
# Décommenter uniquement pour un test local sans clé API :
# GEMINI_ALLOW_NO_AUTH=false
# Origines CORS autorisées (vide = aucun en-tête CORS) et hôtes autorisés :
# GEMINI_CORS_ORIGINS=
# GEMINI_ALLOWED_HOSTS=
# Proxy HTTP(S) sortant optionnel (sinon HTTP_PROXY / HTTPS_PROXY du système) :
# GEMINI_PROXY=

# --- Session Google & Sobriété anti-robot (K14 / K18) ---
# Chemin vers le fichier cookie (recommandé, droits 0600 ; format brut "k=v; k=v").
# Requis pour l'authentification : __Secure-1PSID, __Secure-1PSIDTS et SAPISID.
GEMINI_COOKIE_FILE=
# Ou chaîne inline (déconseillé en production, préférer GEMINI_COOKIE_FILE) :
# GEMINI_COOKIE=
# Index de compte Google (/u/N) si multi-comptes :
# GEMINI_AUTH_USER=
# Rotation en arrière-plan de __Secure-1PSIDTS : désactivée par défaut (K14, évite les /sorry).
GEMINI_COOKIE_ROTATION=false
# Commande externe de rafraîchissement du cookie (ex. script Chrome headless macOS) :
# GEMINI_COOKIE_REFRESH_CMD=
# Auto-refresh on_demand (s'exécute avant une requête si le jeton dépasse l'intervalle ; jamais au repos) :
GEMINI_COOKIE_AUTO_REFRESH_ENABLED=false
GEMINI_COOKIE_AUTO_REFRESH_MIN=90
# Fenêtre de calme (minutes) : aucun appel de fond Google quand aucune requête n'a eu lieu :
GEMINI_IDLE_QUIET_MIN=10
# Reprise auth & rafraîchissement auto du catalogue : désactivés par défaut (K14) :
GEMINI_AUTH_RECOVERY=false
GEMINI_CATALOG_REFRESH_AFTER_COOKIE=false
GEMINI_MODELS_REFRESH_HOURS=0
# Plafond du backoff exponentiel en cas de blocage anti-robot (/sorry) :
GEMINI_BLOCK_MAX_BACKOFF_MIN=60
# Durée maximale de réutilisation de l'état de session persisté (.state.json) en minutes (24 h) :
GEMINI_STATE_MAX_AGE_MIN=1440

# --- Modèles, Réflexion & Requêtes Google ---
# Modèle par défaut si aucun n'est précisé :
GEMINI_DEFAULT_MODEL=gemini-3.5-flash
# Build label Gemini web ("auto" = résolu depuis la page /app et persisté dans .state.json) :
GEMINI_BL=auto
# Niveau de réflexion par défaut (low | medium | high ; vide = ne rien forcer) :
# GEMINI_THINKING_LEVEL=high
# Tentatives / délai / timeout amont :
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_DELAY_SEC=2
GEMINI_REQUEST_TIMEOUT_SEC=180
# Conversations temporaires (inner[45]=1, n'enregistre pas dans l'historique web Gemini).
# Peut aussi être basculé à chaud depuis GMINI Control (/_ui) et conservé dans .state.json.
GEMINI_TEMPORARY_CHAT=false
# Limite dure sur la taille du prompt (0 = illimité) et seuil d'alerte orange dans /_ui (Ko) :
GEMINI_MAX_PROMPT_BYTES=0
GEMINI_PROMPT_WARN_KB=300

# --- Streaming, Keepalives & Garde-fous outils (K9 – K20) ---
# Battements SSE keepalive (secondes) et note d'attente dans les pensées (0 = désactivé) :
GEMINI_SSE_KEEPALIVE_SEC=15
GEMINI_WAIT_NOTE_SEC=15
GEMINI_SILENCE_WARN_SEC=45
GEMINI_SHUTDOWN_GRACE_SEC=30
# Progression en direct des outils et diffusion des pensées (reasoning_content) :
GEMINI_STREAM_TOOLS_PROGRESS=true
GEMINI_STREAM_THOUGHTS=true
# Garde-fous anti-emballement (early_stop) :
GEMINI_MAX_HELD_BYTES=262144
GEMINI_MAX_HELD_SEC=120
# Anti-écho & règles d'outils :
GEMINI_STRIP_HISTORY_ECHO=true
GEMINI_TOOL_PROMPT_NOECHO_RULES=true
GEMINI_TOOL_PROMPT_REMINDER=true
GEMINI_NEUTRALIZE_HISTORY_MARKERS=true
GEMINI_DROP_TEXT_AFTER_TOOL_CALL=true
# Anti bac à sable interne Gemini & raccourci code_reference → run_command (K17 / K18) :
GEMINI_NO_INTERNAL_CODE_EXEC_RULE=true
GEMINI_CODE_REF_FASTPATH=true
GEMINI_INTERNAL_TOOL_ACTION=notify
# Relance sur erreur interne Google (inner[31]=true) : off | once (K15) :
GEMINI_CANNED_ERROR_RETRY=off
GEMINI_CANNED_ERROR_RETRY_SEC=25
# Audit mécanique des outils & séparation read_file + write_file (K20) :
GEMINI_TOOL_AUDIT_NOTE=true
GEMINI_SPLIT_READ_WRITE_BATCH=true
# Alerte de repli silencieux probable sur un autre modèle :
GEMINI_WARN_SUSPECT_FALLBACK=true
GEMINI_WARN_SUSPECT_COOLDOWN_MIN=10

# --- Interface de contrôle (/_ui) & Journaux ---
GEMINI_UI=true
# Chemin vers custom_models.json d'Antigravity ("off" pour masquer la section dans /_ui) :
# GEMINI_ANTIGRAVITY_MODELS_FILE=
GEMINI_LOG_REQUESTS=false
GEMINI_LOG_FORMAT=text
# Traces complètes d'échanges (contiennent prompts/réponses, droits 0600, jamais de cookies) :
# GEMINI_TRACE_DIR=
# GEMINI_TRACE_MAX_FILES=200
# GEMINI_TRACE_RAW=false
# Téléchargement d'images distantes (désactivé par défaut pour éviter le SSRF) :
GEMINI_ALLOW_REMOTE_IMAGES=false
